<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>at.flauschigesalex.lib</groupId>
    <artifactId>parent-library</artifactId>
    <version>2.0.4</version>
    <packaging>pom</packaging>

    <modules>
        <module>base</module>
        <module>database</module>
        <module>discord</module>
        <module>minecraft</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <kotlin.version>2.4.20</kotlin.version>
        
        <adventure.version>5.2.0</adventure.version>
        <annotations.version>26.1.0</annotations.version>
        <coroutines.version>1.11.0</coroutines.version>
        <jda.version>6.4.1</jda.version>
        <kotlinx-serialization.version>1.11.0</kotlinx-serialization.version>
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <minio.version>9.0.1</minio.version>
        <mongodb-driver.version>5.6.2</mongodb-driver.version>
        <okhttp.version>5.3.2</okhttp.version>
        <paper-api.version>[26.2.build, 26.3.build)</paper-api.version>
        <reflections.version>0.10.2</reflections.version>
        <velocity-api.version>4.1.2-SNAPSHOT</velocity-api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Reactor artifacts -->
            <dependency>
                <groupId>at.flauschigesalex.lib.base</groupId>
                <artifactId>default-cache</artifactId>
                <version>1.0.0</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.base</groupId>
                <artifactId>default-file</artifactId>
                <version>3.1.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.base</groupId>
                <artifactId>default-general</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.base</groupId>
                <artifactId>default-time</artifactId>
                <version>2.0.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.database</groupId>
                <artifactId>database-base</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.database</groupId>
                <artifactId>database-minio</artifactId>
                <version>3.0.1</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.database</groupId>
                <artifactId>database-mongo</artifactId>
                <version>3.1.1</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.discord</groupId>
                <artifactId>discord-base</artifactId>
                <version>1.0.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft</groupId>
                <artifactId>minecraft-api</artifactId>
                <version>2.1.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft</groupId>
                <artifactId>minecraft-brigadier</artifactId>
                <version>3.1.3</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft.paper</groupId>
                <artifactId>minecraft-paper-base</artifactId>
                <version>3.2.3</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft.paper</groupId>
                <artifactId>minecraft-paper-dialog</artifactId>
                <version>1.0.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft.paper</groupId>
                <artifactId>minecraft-paper-ui</artifactId>
                <version>3.0.2</version>
            </dependency>
            <dependency>
                <groupId>at.flauschigesalex.lib.minecraft.velocity</groupId>
                <artifactId>minecraft-velocity-base</artifactId>
                <version>3.2.2</version>
            </dependency>

            <!-- Third-party dependencies -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-reflect</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-serialization-json</artifactId>
                <version>${kotlinx-serialization.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-serialization-core</artifactId>
                <version>${kotlinx-serialization.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlinx</groupId>
                <artifactId>kotlinx-coroutines-core</artifactId>
                <version>${coroutines.version}</version>
            </dependency>
            <dependency>
                <groupId>org.reflections</groupId>
                <artifactId>reflections</artifactId>
                <version>${reflections.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mongodb</groupId>
                <artifactId>mongodb-driver-sync</artifactId>
                <version>${mongodb-driver.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>net.dv8tion</groupId>
                <artifactId>JDA</artifactId>
                <version>${jda.version}</version>
            </dependency>
            <dependency>
                <groupId>net.kyori</groupId>
                <artifactId>adventure-api</artifactId>
                <version>${adventure.version}</version>
            </dependency>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper-api.version}</version>
            </dependency>
            <dependency>
                <groupId>com.velocitypowered</groupId>
                <artifactId>velocity-api</artifactId>
                <version>${velocity-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
    </dependencies>
    
    <repositories>
        <repository>
            <id>flx-library</id>
            <url>https://repo.flauschigesalex.at/repository/maven-public/</url>
        </repository>
    </repositories>

    <distributionManagement>
        <repository>
            <id>flx-library</id>
            <url>https://repo.flauschigesalex.at/repository/maven-public/</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </distributionManagement>
    
    <build>
        <directory>.target</directory>
        <sourceDirectory>src/main/kotlin</sourceDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>

                <configuration>
                    <compilerPlugins>
                        <plugin>kotlinx-serialization</plugin>
                    </compilerPlugins>
                    <args>
                        <arg>-Xcompanion-blocks-and-extensions</arg>
                        <arg>-opt-in=kotlinx.serialization.ExperimentalSerializationApi</arg>
                    </args>
                </configuration>

                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                </executions>

                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-serialization</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
